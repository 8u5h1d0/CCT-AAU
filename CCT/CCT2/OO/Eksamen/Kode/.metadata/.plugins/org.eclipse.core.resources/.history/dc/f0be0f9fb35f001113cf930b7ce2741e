package emne8AsynkronKommunikation;

import java.io.*;
import java.net.*;

public class EchoClient {

    public static void main(String[] args) {

        try (
            Socket socket = new Socket("127.0.0.1", 8080);

            BufferedReader in = new BufferedReader(
                    new InputStreamReader(socket.getInputStream())); // byte -> char -> + buffer

            PrintWriter out = new PrintWriter(
                    socket.getOutputStream(), true); // true = AUTO-FLUSH // char -> byte 

            BufferedReader console = new BufferedReader(
                    new InputStreamReader(System.in)) // byte -> char -> + buffer
        ) {

            System.out.println("Connected to server. Type messages:");

            String input;

            while ((input = console.readLine()) != null) {

                out.println(input); // send to server

                String response = in.readLine(); // wait for echo

                System.out.println(response); // print echo
            }

        } catch (IOException e) {
            e.printStackTrace();
        }
    }
}
