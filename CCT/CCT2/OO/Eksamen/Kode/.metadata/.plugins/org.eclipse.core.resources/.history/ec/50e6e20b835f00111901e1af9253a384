package emne4Polymorphism;

public class BindingDemo {

    public static void main(String[] args) {

        System.out.println("=== STATIC BINDING ===");

        Bicycle b = new Bicycle();
        b.move(); // compiler knows exactly: Bicycle.move()


        System.out.println("\n=== DYNAMIC BINDING ===");

        Vehicle v = new Bicycle(); // upcasting

        v.move(); // runtime decides which move() to use
    }
}

// =====================
// SUPERCLASS
// =====================
class Vehicle {

    public void move() {
        System.out.println("Vehicle is moving");
    }
}

// =====================
// SUBCLASS
// =====================
class Bicycle extends Vehicle {

    @Override
    public void move() {
        System.out.println("Bicycle is moving");
    }
}
