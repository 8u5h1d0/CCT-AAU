class Bicycle {
//	Atributter (i dette tilfælde, kun en: farve)
    String color;
    
// --------------------------------------------------------------------------------------------------------------

//	Metoder (i dette tilfælde to, en der sætter farven og en der ringer med klokken)
    public Bicycle(String color) {
    //'this' keyword
        this.color = color;
    }

    public void ringBell() {
        System.out.println(
        	//color står ikke i "" fordi det er atributet af objectet der kalder metoden
                color + " bicycle: Ring Ring!");
    }
}