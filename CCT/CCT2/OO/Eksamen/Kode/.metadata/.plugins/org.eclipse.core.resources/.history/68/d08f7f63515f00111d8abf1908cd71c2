package emne1KlasserGenerelt;

public class ImperativeDemo {

    public static void main(String[] args) {

    	// Først laver vi en double, og giver den værdien 100(.0)
        double balance = 100; 
        System.out.printf("før deposit: %f \n", balance);

        // Så tilføjer vi en mængde gennem deposit funktionen
        balance = deposit(balance, 50); // balance
        System.out.printf("efter depost: %f", balance);
    }

    // deposit funktion; tager nuværende værdi af blaance, og tilføjer en givet mængde "amount"
    public static double deposit(double balance,
                                 double amount) {

        return balance + amount;
    }
}

public class OOPDemo {

    public static void main(String[] args) {

        BankAccount account =
                new BankAccount(100);

        account.deposit(50);

        System.out.println(
                account.getBalance());
    }
}

class BankAccount {

    private double balance;

    public BankAccount(double balance) {
        this.balance = balance;
    }

    public void deposit(double amount) {
        balance += amount;
    }

    public double getBalance() {
        return balance;
    }
}