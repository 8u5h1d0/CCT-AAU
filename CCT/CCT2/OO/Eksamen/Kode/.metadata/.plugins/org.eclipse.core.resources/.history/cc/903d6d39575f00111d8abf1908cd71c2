package emne1KlasserGenerelt;

public class EncapsulationDemo {

    public static void main(String[] args) {

        System.out.println("Ikke gemt");

        BadBankAccount badAccount = new BadBankAccount();

        // Direct access (bad design)
        badAccount.balance = 100;
        badAccount.balance = -999999; // no protection!

        System.out.println("Bad account balance: " + badAccount.balance);


        System.out.println("\n=== GOOD VERSION ===");

        GoodBankAccount goodAccount = new GoodBankAccount();

        // Cannot access balance directly:
        // goodAccount.balance = -999999; ❌ does NOT compile

        goodAccount.deposit(100);
        goodAccount.deposit(-500); // ignored (protected)

        System.out.println("Good account balance: " + goodAccount.getBalance());
    }
}


// ❌ BAD VERSION (no encapsulation)
class BadBankAccount {
    public double balance;
}


// ✅ GOOD VERSION (encapsulation)
class GoodBankAccount {

    private double balance;

    public void deposit(double amount) {
        if (amount > 0) {
            balance += amount;
        }
    }

    public double getBalance() {
        return balance;
    }
}