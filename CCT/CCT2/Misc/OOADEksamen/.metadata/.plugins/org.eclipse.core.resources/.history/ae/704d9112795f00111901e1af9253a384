package emne3ObjekterOgDatastrukturer;

import java.util.LinkedList;

public class LinkedListDemo {

    public static void main(String[] args) {

        System.out.println("CREATE LINKEDLIST");

        LinkedList<String> list = new LinkedList<>();

        System.out.println(list);
        list.add("A");
        list.add("B");
        list.add("C");

        System.out.println(list);


        System.out.println("\nFAST INSERT AT FRONT");

        list.addFirst("START");

        System.out.println(list);


        System.out.println("\nFAST INSERT AT END");

        list.addLast("END");

        System.out.println(list);


        System.out.println("\nREMOVE FIRST");

        list.removeFirst();

        System.out.println(list);


        System.out.println("\nACCESS BY INDEX");

        System.out.println("Index 0 = " + list.get(0));
        System.out.println("Index 2 = " + list.get(2));


        System.out.println("\nITERATE THROUGH NODES");

        for (String item : list) {
            System.out.println(item);
        }
    }
}
