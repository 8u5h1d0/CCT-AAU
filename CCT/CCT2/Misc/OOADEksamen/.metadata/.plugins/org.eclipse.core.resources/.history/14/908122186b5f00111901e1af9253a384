package emne2KlasserOgRelationer;

public class SuperDemo {

	    public static void main(String[] args) {

	        System.out.println("=== Creating Dog object ===");
	        Dog d = new Dog();

	        System.out.println("\n=== Calling shared method ===");
	        d.makeSound();   // inherited from Animal

	        System.out.println("\n=== Calling Dog-only method ===");
	        d.fetch();       // only exists in Dog
	    }
	}


	// PARENT CLASS
	class Animal {

	    public Animal() {
	        System.out.println("Animal constructor called (super)");
	    }

	    // 🔹 Shared method (Animal + Dog)
	    public void makeSound() {
	        System.out.println("Animal sound: generic roar");
	    }
	}


	// CHILD CLASS
	class Dog extends Animal {

	    public Dog() {
	        super(); // implicit if omitted, but shown for clarity
	        System.out.println("Dog constructor called");
	    }

	    // 🔸 Dog-only method
	    public void fetch() {
	        System.out.println("Dog fetches the ball 🦴");
	    }
	}