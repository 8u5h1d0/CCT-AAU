package emne1KlasserGenerelt;



class KlassesAnatomi {

    // ATTRIBUTE
    private String name;

    // METHOD
    public void introduce() {

        System.out.println(
                "Hello, I'm " + name);
    }
    
    // CONSTRUCTOR
    public KlassesAnatomi(String name) {

        // "this" keyword
        this.name = name;
    }
        
    public static void main(String[] args) {
    	KlassesAnatomi demo = new KlassesAnatomi("navn");
    	demo.introduce();
    }
}
